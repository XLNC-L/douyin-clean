{
  "manifest_version": 3,
  "name": "抖音净播 · Douyin Clean",
  "version": "1.9.5",
  "description": "自动最高清晰度（含 4K）、带货广告与直播过滤、失焦暂停、纯净布局、视频底部进度条（可开关换色），并强制隐藏 AI 抖音入口。事件驱动实现，刷视频不卡顿。",
  "permissions": ["storage"],
  "host_permissions": ["https://www.douyin.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "抖音净播 · Douyin Clean",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.douyin.com/*"],
      "run_at": "document_start",
      "all_frames": false,
      "css": ["css/content.css"],
      "js": [
        "js/core.js",
        "js/defaults.js",
        "js/settings.js",
        "js/nav.js",
        "js/overlay.js",
        "js/quality.js",
        "js/filter.js",
        "js/header.js",
        "js/progress.js",
        "js/main.js"
      ]
    }
  ]
}
