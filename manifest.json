{
  "manifest_version": 3,
  "name": "抖音净播 · Douyin Clean",
  "version": "1.6.0",
  "description": "自动最高清晰度（含 4K）、带货广告自动跳过、失焦暂停、纯净布局。事件驱动实现，不轮询、不全站监听，刷视频不卡顿。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "抖音净播 · Douyin Clean",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.douyin.com/*"],
      "run_at": "document_start",
      "all_frames": false,
      "css": ["css/content.css"],
      "js": [
        "js/core.js",
        "js/overlay.js",
        "js/quality.js",
        "js/filter.js",
        "js/header.js",
        "js/main.js"
      ]
    }
  ]
}
